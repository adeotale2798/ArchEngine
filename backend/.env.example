# Copy to .env and fill in real values. Never commit .env.
MONGODB_USERNAME=replace-with-atlas-username
MONGODB_PASSWORD=replace-with-atlas-password
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DB_NAME=archengine_local
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_MINUTES=480
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password
ARCHITECT_EMAIL=architect@example.com
ARCHITECT_PASSWORD=replace-with-a-strong-password
SEED_TENANT_B=false
